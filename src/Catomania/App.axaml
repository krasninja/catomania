<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Catomania"
             xmlns:localization="using:Catomania.Localization"
             xmlns:models="using:Catomania.Models"
             x:Class="Catomania.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <!-- The tray icon shows the same options as the animal's context menu, so the animal can be
         controlled even when it is out of reach or paused. The items with a check mark keep the
         setting they show in CommandParameter, like the animal's menu items keep it in Tag. -->
    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/Icon.ico"
                      ToolTipText="Catomania"
                      IsVisible="False">
                <TrayIcon.Menu>
                    <NativeMenu Opening="OnTrayMenuOpening">
                        <NativeMenuItem Header="{x:Static localization:Strings.Pause}"
                                        ToggleType="CheckBox"
                                        CommandParameter="{x:Static local:App.PauseSetting}"
                                        Click="OnPauseClick" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="{x:Static localization:Strings.Animal}">
                            <NativeMenu>
                                <NativeMenuItem Header="{x:Static localization:Strings.Cat}"
                                                ToggleType="Radio"
                                                CommandParameter="{x:Static models:AnimalKind.Cat}"
                                                Click="OnAnimalClick" />
                                <NativeMenuItem Header="{x:Static localization:Strings.Muchi}"
                                                ToggleType="Radio"
                                                CommandParameter="{x:Static models:AnimalKind.Muchi}"
                                                Click="OnAnimalClick" />
                                <NativeMenuItem Header="{x:Static localization:Strings.Panda}"
                                                ToggleType="Radio"
                                                CommandParameter="{x:Static models:AnimalKind.Panda}"
                                                Click="OnAnimalClick" />
                                <NativeMenuItem Header="{x:Static localization:Strings.Dog}"
                                                ToggleType="Radio"
                                                CommandParameter="{x:Static models:AnimalKind.Dog}"
                                                Click="OnAnimalClick" />
                                <NativeMenuItem Header="{x:Static localization:Strings.Snake}"
                                                ToggleType="Radio"
                                                CommandParameter="{x:Static models:AnimalKind.Snake}"
                                                Click="OnAnimalClick" />
                                <NativeMenuItem Header="{x:Static localization:Strings.Parrot}"
                                                ToggleType="Radio"
                                                CommandParameter="{x:Static models:AnimalKind.Parrot}"
                                                Click="OnAnimalClick" />
                                <NativeMenuItem Header="{x:Static localization:Strings.Pig}"
                                                ToggleType="Radio"
                                                CommandParameter="{x:Static models:AnimalKind.Pig}"
                                                Click="OnAnimalClick" />
                                <NativeMenuItem Header="{x:Static localization:Strings.Frog}"
                                                ToggleType="Radio"
                                                CommandParameter="{x:Static models:AnimalKind.Frog}"
                                                Click="OnAnimalClick" />
                                <NativeMenuItem Header="{x:Static localization:Strings.Capybara}"
                                                ToggleType="Radio"
                                                CommandParameter="{x:Static models:AnimalKind.Capybara}"
                                                Click="OnAnimalClick" />
                                <NativeMenuItem Header="{x:Static localization:Strings.Nolu}"
                                                ToggleType="Radio"
                                                CommandParameter="{x:Static models:AnimalKind.Nolu}"
                                                Click="OnAnimalClick" />
                            </NativeMenu>
                        </NativeMenuItem>
                        <NativeMenuItem Header="{x:Static localization:Strings.Speed}">
                            <NativeMenu>
                                <NativeMenuItem Header="{x:Static localization:Strings.Slow}"
                                                ToggleType="Radio"
                                                CommandParameter="{x:Static models:AnimalSpeed.Slow}"
                                                Click="OnSpeedClick" />
                                <NativeMenuItem Header="{x:Static localization:Strings.Normal}"
                                                ToggleType="Radio"
                                                CommandParameter="{x:Static models:AnimalSpeed.Normal}"
                                                Click="OnSpeedClick" />
                                <NativeMenuItem Header="{x:Static localization:Strings.Fast}"
                                                ToggleType="Radio"
                                                CommandParameter="{x:Static models:AnimalSpeed.Fast}"
                                                Click="OnSpeedClick" />
                            </NativeMenu>
                        </NativeMenuItem>
                        <NativeMenuItem Header="{x:Static localization:Strings.Fur}"
                                        CommandParameter="{x:Static local:App.FurSetting}">
                            <NativeMenu>
                                <NativeMenuItem Header="{x:Static localization:Strings.Ginger}"
                                                ToggleType="Radio"
                                                CommandParameter="{x:Static models:CatColorScheme.Ginger}"
                                                Click="OnColorSchemeClick" />
                                <NativeMenuItem Header="{x:Static localization:Strings.Gray}"
                                                ToggleType="Radio"
                                                CommandParameter="{x:Static models:CatColorScheme.Gray}"
                                                Click="OnColorSchemeClick" />
                                <NativeMenuItem Header="{x:Static localization:Strings.Black}"
                                                ToggleType="Radio"
                                                CommandParameter="{x:Static models:CatColorScheme.Black}"
                                                Click="OnColorSchemeClick" />
                                <NativeMenuItem Header="{x:Static localization:Strings.Cream}"
                                                ToggleType="Radio"
                                                CommandParameter="{x:Static models:CatColorScheme.Cream}"
                                                Click="OnColorSchemeClick" />
                                <NativeMenuItem Header="{x:Static localization:Strings.LiverAndWhite}"
                                                ToggleType="Radio"
                                                CommandParameter="{x:Static models:DogCoat.Liver}"
                                                Click="OnColorSchemeClick" />
                                <NativeMenuItem Header="{x:Static localization:Strings.BlackAndWhite}"
                                                ToggleType="Radio"
                                                CommandParameter="{x:Static models:DogCoat.Black}"
                                                Click="OnColorSchemeClick" />
                                <NativeMenuItem Header="{x:Static localization:Strings.RedAndWhite}"
                                                ToggleType="Radio"
                                                CommandParameter="{x:Static models:DogCoat.Red}"
                                                Click="OnColorSchemeClick" />
                                <NativeMenuItem Header="{x:Static localization:Strings.LemonAndWhite}"
                                                ToggleType="Radio"
                                                CommandParameter="{x:Static models:DogCoat.Lemon}"
                                                Click="OnColorSchemeClick" />
                                <NativeMenuItem Header="{x:Static localization:Strings.Mint}"
                                                ToggleType="Radio"
                                                CommandParameter="{x:Static models:SnakeSkin.Mint}"
                                                Click="OnColorSchemeClick" />
                                <NativeMenuItem Header="{x:Static localization:Strings.DarkGreen}"
                                                ToggleType="Radio"
                                                CommandParameter="{x:Static models:SnakeSkin.DarkGreen}"
                                                Click="OnColorSchemeClick" />
                                <NativeMenuItem Header="{x:Static localization:Strings.Blue}"
                                                ToggleType="Radio"
                                                CommandParameter="{x:Static models:SnakeSkin.Blue}"
                                                Click="OnColorSchemeClick" />
                                <NativeMenuItem Header="{x:Static localization:Strings.Pink}"
                                                ToggleType="Radio"
                                                CommandParameter="{x:Static models:SnakeSkin.Pink}"
                                                Click="OnColorSchemeClick" />
                                <NativeMenuItem Header="{x:Static localization:Strings.Yellow}"
                                                ToggleType="Radio"
                                                CommandParameter="{x:Static models:SnakeSkin.Yellow}"
                                                Click="OnColorSchemeClick" />
                                <NativeMenuItem Header="{x:Static localization:Strings.Orange}"
                                                ToggleType="Radio"
                                                CommandParameter="{x:Static models:MuchiFur.Orange}"
                                                Click="OnColorSchemeClick" />
                                <NativeMenuItem Header="{x:Static localization:Strings.Gray}"
                                                ToggleType="Radio"
                                                CommandParameter="{x:Static models:MuchiFur.Gray}"
                                                Click="OnColorSchemeClick" />
                                <NativeMenuItem Header="{x:Static localization:Strings.Black}"
                                                ToggleType="Radio"
                                                CommandParameter="{x:Static models:MuchiFur.Black}"
                                                Click="OnColorSchemeClick" />
                                <NativeMenuItem Header="{x:Static localization:Strings.Beige}"
                                                ToggleType="Radio"
                                                CommandParameter="{x:Static models:MuchiFur.Beige}"
                                                Click="OnColorSchemeClick" />
                                <NativeMenuItem Header="{x:Static localization:Strings.Brown}"
                                                ToggleType="Radio"
                                                CommandParameter="{x:Static models:MuchiFur.Brown}"
                                                Click="OnColorSchemeClick" />
                                <NativeMenuItem Header="{x:Static localization:Strings.Scarlet}"
                                                ToggleType="Radio"
                                                CommandParameter="{x:Static models:ParrotPlumage.Scarlet}"
                                                Click="OnColorSchemeClick" />
                                <NativeMenuItem Header="{x:Static localization:Strings.BlueAndGold}"
                                                ToggleType="Radio"
                                                CommandParameter="{x:Static models:ParrotPlumage.BlueAndGold}"
                                                Click="OnColorSchemeClick" />
                                <NativeMenuItem Header="{x:Static localization:Strings.Green}"
                                                ToggleType="Radio"
                                                CommandParameter="{x:Static models:ParrotPlumage.Green}"
                                                Click="OnColorSchemeClick" />
                                <NativeMenuItem Header="{x:Static localization:Strings.Hyacinth}"
                                                ToggleType="Radio"
                                                CommandParameter="{x:Static models:ParrotPlumage.Hyacinth}"
                                                Click="OnColorSchemeClick" />
                            </NativeMenu>
                        </NativeMenuItem>
                        <NativeMenuItem Header="{x:Static localization:Strings.Size}">
                            <NativeMenu>
                                <NativeMenuItem Header="{x:Static localization:Strings.Small}"
                                                ToggleType="Radio"
                                                CommandParameter="{x:Static models:AnimalSize.Small}"
                                                Click="OnSizeClick" />
                                <NativeMenuItem Header="{x:Static localization:Strings.Medium}"
                                                ToggleType="Radio"
                                                CommandParameter="{x:Static models:AnimalSize.Medium}"
                                                Click="OnSizeClick" />
                                <NativeMenuItem Header="{x:Static localization:Strings.Large}"
                                                ToggleType="Radio"
                                                CommandParameter="{x:Static models:AnimalSize.Large}"
                                                Click="OnSizeClick" />
                            </NativeMenu>
                        </NativeMenuItem>
                        <NativeMenuItem Header="{x:Static localization:Strings.Configuration}">
                            <NativeMenu>
                                <NativeMenuItem Header="{x:Static localization:Strings.LaunchAtStartup}"
                                                ToggleType="CheckBox"
                                                CommandParameter="{x:Static local:App.LaunchAtStartupSetting}"
                                                Click="OnLaunchAtStartupClick" />
                                <NativeMenuItem Header="{x:Static localization:Strings.AlwaysOnTop}"
                                                ToggleType="CheckBox"
                                                CommandParameter="{x:Static local:App.AlwaysOnTopSetting}"
                                                Click="OnTopmostClick" />
                            </NativeMenu>
                        </NativeMenuItem>
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="{x:Static localization:Strings.Recenter}"
                                        Click="OnRecenterClick" />
                        <NativeMenuItem Header="{x:Static localization:Strings.CheckForUpdates}"
                                        Click="OnCheckUpdatesClick" />
                        <NativeMenuItem Header="{x:Static localization:Strings.Help}">
                            <NativeMenu>
                                <NativeMenuItem Header="{x:Static localization:Strings.Website}"
                                                Click="OnWebsiteClick" />
                                <NativeMenuItem Header="{x:Static localization:Strings.About}"
                                                Click="OnAboutClick" />
                            </NativeMenu>
                        </NativeMenuItem>
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="{x:Static localization:Strings.QuitCatomania}"
                                        Click="OnQuitClick" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
