<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Catomania</AssemblyName>
    <RootNamespace>Catomania</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Icon.ico</ApplicationIcon>
    <Product>Catomania</Product>
    <Description>A kitty that chases the mouse cursor across the screen.</Description>
  </PropertyGroup>

  <!-- The application ships as a Native AOT binary: no JIT, faster startup and a smaller footprint.
       These properties only take effect during "dotnet publish"; day to day builds and the test
       project keep using the regular JIT pipeline. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
    <StripSymbols>true</StripSymbols>
    <DebuggerSupport>false</DebuggerSupport>
    <!-- Report warnings per assembly instead of collapsing them into a single one, so the
         analyzer output stays actionable. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <!-- Native AOT is always a single file, the single file bundler must stay out of the way. -->
    <PublishSingleFile>false</PublishSingleFile>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <EmbeddedResource Include="Input\Scripts\kwin-cursor.js" LogicalName="Catomania.Input.Scripts.kwin-cursor.js" />
    <EmbeddedResource Include="Input\Scripts\GnomeShellExtension\*" LogicalName="Catomania.Input.Scripts.GnomeShellExtension.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <!-- Wayland cursor tracking through KWin and GNOME Shell, the same version Avalonia brings. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
