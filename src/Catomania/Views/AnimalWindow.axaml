<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:Catomania.Controls"
        xmlns:models="using:Catomania.Models"
        mc:Ignorable="d"
        x:Class="Catomania.Views.AnimalWindow"
        Title="Catomania"
        Icon="/Assets/Icon.ico"
        Width="104"
        Height="104"
        Background="Transparent"
        CanResize="False"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        Topmost="True"
        TransparencyLevelHint="Transparent">

    <Grid>
        <controls:AnimalView x:Name="AnimalView" />
        <Border x:Name="SpeechBubble"
                Background="#A9FFFFFF"
                CornerRadius="8"
                Padding="8,4"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,4,0,0"
                IsVisible="False">
            <TextBlock x:Name="SpeechText"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="#E6333333" />
        </Border>
    </Grid>

    <Window.ContextMenu>
        <ContextMenu x:Name="AnimalContextMenu">
            <MenuItem x:Name="PauseMenuItem"
                      Header="Pause"
                      ToggleType="CheckBox"
                      Click="OnPauseClick" />
            <Separator />
            <MenuItem Header="Animal">
                <MenuItem Header="Cat"
                          GroupName="Animal"
                          Tag="{x:Static models:AnimalKind.Cat}"
                          ToggleType="Radio"
                          Click="OnAnimalClick" />
                <MenuItem Header="Panda"
                          GroupName="Animal"
                          Tag="{x:Static models:AnimalKind.Panda}"
                          ToggleType="Radio"
                          Click="OnAnimalClick" />
                <MenuItem Header="Dog"
                          GroupName="Animal"
                          Tag="{x:Static models:AnimalKind.Dog}"
                          ToggleType="Radio"
                          Click="OnAnimalClick" />
                <MenuItem Header="Snake"
                          GroupName="Animal"
                          Tag="{x:Static models:AnimalKind.Snake}"
                          ToggleType="Radio"
                          Click="OnAnimalClick" />
                <MenuItem Header="Parrot"
                          GroupName="Animal"
                          Tag="{x:Static models:AnimalKind.Parrot}"
                          ToggleType="Radio"
                          Click="OnAnimalClick" />
            </MenuItem>
            <MenuItem Header="Speed">
                <MenuItem Header="Slow"
                          GroupName="Speed"
                          Tag="{x:Static models:AnimalSpeed.Slow}"
                          ToggleType="Radio"
                          Click="OnSpeedClick" />
                <MenuItem Header="Normal"
                          GroupName="Speed"
                          Tag="{x:Static models:AnimalSpeed.Normal}"
                          ToggleType="Radio"
                          Click="OnSpeedClick" />
                <MenuItem Header="Fast"
                          GroupName="Speed"
                          Tag="{x:Static models:AnimalSpeed.Fast}"
                          ToggleType="Radio"
                          Click="OnSpeedClick" />
            </MenuItem>
            <MenuItem x:Name="FurMenuItem"
                      Header="Fur">
                <MenuItem Header="Ginger"
                          GroupName="Fur"
                          Tag="{x:Static models:CatColorScheme.Ginger}"
                          ToggleType="Radio"
                          Click="OnColorSchemeClick" />
                <MenuItem Header="Gray"
                          GroupName="Fur"
                          Tag="{x:Static models:CatColorScheme.Gray}"
                          ToggleType="Radio"
                          Click="OnColorSchemeClick" />
                <MenuItem Header="Black"
                          GroupName="Fur"
                          Tag="{x:Static models:CatColorScheme.Black}"
                          ToggleType="Radio"
                          Click="OnColorSchemeClick" />
                <MenuItem Header="Cream"
                          GroupName="Fur"
                          Tag="{x:Static models:CatColorScheme.Cream}"
                          ToggleType="Radio"
                          Click="OnColorSchemeClick" />
            </MenuItem>
            <MenuItem Header="Size">
                <MenuItem Header="Small"
                          GroupName="Size"
                          Tag="{x:Static models:AnimalSize.Small}"
                          ToggleType="Radio"
                          Click="OnSizeClick" />
                <MenuItem Header="Medium"
                          GroupName="Size"
                          Tag="{x:Static models:AnimalSize.Medium}"
                          ToggleType="Radio"
                          Click="OnSizeClick" />
                <MenuItem Header="Large"
                          GroupName="Size"
                          Tag="{x:Static models:AnimalSize.Large}"
                          ToggleType="Radio"
                          Click="OnSizeClick" />
            </MenuItem>
            <MenuItem Header="Configuration">
                <MenuItem x:Name="TopmostMenuItem"
                          Header="Always on Top"
                          ToggleType="CheckBox"
                          Click="OnTopmostClick" />
                <MenuItem x:Name="LaunchAtStartupMenuItem"
                          Header="Launch at system startup"
                          ToggleType="CheckBox"
                          Click="OnLaunchAtStartupClick" />
            </MenuItem>
            <Separator />
            <MenuItem Header="Recenter"
                      Click="OnRecenterClick" />
            <MenuItem Header="Check for Updates"
                      Click="OnCheckUpdatesClick" />
            <MenuItem Header="About"
                      Click="OnAboutClick" />
            <Separator />
            <MenuItem Header="Quit"
                      Click="OnQuitClick" />
        </ContextMenu>
    </Window.ContextMenu>

</Window>
