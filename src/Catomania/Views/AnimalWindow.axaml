<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:Catomania.Controls"
        xmlns:localization="using:Catomania.Localization"
        xmlns:models="using:Catomania.Models"
        mc:Ignorable="d"
        x:Class="Catomania.Views.AnimalWindow"
        Title="Catomania"
        Icon="/Assets/Icon.ico"
        Width="104"
        Height="104"
        Background="Transparent"
        CanResize="False"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        Topmost="True"
        TransparencyLevelHint="Transparent">

    <Grid>
        <controls:AnimalView x:Name="AnimalView" />
        <!-- A popup is its own window, so the bubble can sit above the animal instead of covering it. -->
        <Popup x:Name="SpeechBubble"
               PlacementTarget="{Binding #AnimalView}"
               Placement="Top"
               IsLightDismissEnabled="False"
               ShouldUseOverlayLayer="False">
            <Border Background="#A9FFFFFF"
                    CornerRadius="8"
                    Padding="8,4"
                    IsHitTestVisible="False">
                <TextBlock x:Name="SpeechText"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#E6333333" />
            </Border>
        </Popup>
    </Grid>

    <Window.ContextMenu>
        <ContextMenu x:Name="AnimalContextMenu">
            <MenuItem x:Name="PauseMenuItem"
                      Header="{x:Static localization:Strings.Pause}"
                      ToggleType="CheckBox"
                      Click="OnPauseClick" />
            <Separator />
            <MenuItem Header="{x:Static localization:Strings.Animal}">
                <MenuItem Header="{x:Static localization:Strings.Cat}"
                          GroupName="Animal"
                          Tag="{x:Static models:AnimalKind.Cat}"
                          ToggleType="Radio"
                          Click="OnAnimalClick" />
                <MenuItem Header="{x:Static localization:Strings.Panda}"
                          GroupName="Animal"
                          Tag="{x:Static models:AnimalKind.Panda}"
                          ToggleType="Radio"
                          Click="OnAnimalClick" />
                <MenuItem Header="{x:Static localization:Strings.Dog}"
                          GroupName="Animal"
                          Tag="{x:Static models:AnimalKind.Dog}"
                          ToggleType="Radio"
                          Click="OnAnimalClick" />
                <MenuItem Header="{x:Static localization:Strings.Snake}"
                          GroupName="Animal"
                          Tag="{x:Static models:AnimalKind.Snake}"
                          ToggleType="Radio"
                          Click="OnAnimalClick" />
                <MenuItem Header="{x:Static localization:Strings.Parrot}"
                          GroupName="Animal"
                          Tag="{x:Static models:AnimalKind.Parrot}"
                          ToggleType="Radio"
                          Click="OnAnimalClick" />
                <MenuItem Header="{x:Static localization:Strings.Pig}"
                          GroupName="Animal"
                          Tag="{x:Static models:AnimalKind.Pig}"
                          ToggleType="Radio"
                          Click="OnAnimalClick" />
                <MenuItem Header="{x:Static localization:Strings.Frog}"
                          GroupName="Animal"
                          Tag="{x:Static models:AnimalKind.Frog}"
                          ToggleType="Radio"
                          Click="OnAnimalClick" />
                <MenuItem Header="{x:Static localization:Strings.Capybara}"
                          GroupName="Animal"
                          Tag="{x:Static models:AnimalKind.Capybara}"
                          ToggleType="Radio"
                          Click="OnAnimalClick" />
            </MenuItem>
            <MenuItem Header="{x:Static localization:Strings.Speed}">
                <MenuItem Header="{x:Static localization:Strings.Slow}"
                          GroupName="Speed"
                          Tag="{x:Static models:AnimalSpeed.Slow}"
                          ToggleType="Radio"
                          Click="OnSpeedClick" />
                <MenuItem Header="{x:Static localization:Strings.Normal}"
                          GroupName="Speed"
                          Tag="{x:Static models:AnimalSpeed.Normal}"
                          ToggleType="Radio"
                          Click="OnSpeedClick" />
                <MenuItem Header="{x:Static localization:Strings.Fast}"
                          GroupName="Speed"
                          Tag="{x:Static models:AnimalSpeed.Fast}"
                          ToggleType="Radio"
                          Click="OnSpeedClick" />
            </MenuItem>
            <MenuItem x:Name="FurMenuItem"
                      Header="{x:Static localization:Strings.Fur}">
                <MenuItem Header="{x:Static localization:Strings.Ginger}"
                          GroupName="Fur"
                          Tag="{x:Static models:CatColorScheme.Ginger}"
                          ToggleType="Radio"
                          Click="OnColorSchemeClick" />
                <MenuItem Header="{x:Static localization:Strings.Gray}"
                          GroupName="Fur"
                          Tag="{x:Static models:CatColorScheme.Gray}"
                          ToggleType="Radio"
                          Click="OnColorSchemeClick" />
                <MenuItem Header="{x:Static localization:Strings.Black}"
                          GroupName="Fur"
                          Tag="{x:Static models:CatColorScheme.Black}"
                          ToggleType="Radio"
                          Click="OnColorSchemeClick" />
                <MenuItem Header="{x:Static localization:Strings.Cream}"
                          GroupName="Fur"
                          Tag="{x:Static models:CatColorScheme.Cream}"
                          ToggleType="Radio"
                          Click="OnColorSchemeClick" />
                <MenuItem Header="{x:Static localization:Strings.LiverAndWhite}"
                          GroupName="DogCoat"
                          Tag="{x:Static models:DogCoat.Liver}"
                          ToggleType="Radio"
                          Click="OnColorSchemeClick" />
                <MenuItem Header="{x:Static localization:Strings.BlackAndWhite}"
                          GroupName="DogCoat"
                          Tag="{x:Static models:DogCoat.Black}"
                          ToggleType="Radio"
                          Click="OnColorSchemeClick" />
                <MenuItem Header="{x:Static localization:Strings.RedAndWhite}"
                          GroupName="DogCoat"
                          Tag="{x:Static models:DogCoat.Red}"
                          ToggleType="Radio"
                          Click="OnColorSchemeClick" />
                <MenuItem Header="{x:Static localization:Strings.LemonAndWhite}"
                          GroupName="DogCoat"
                          Tag="{x:Static models:DogCoat.Lemon}"
                          ToggleType="Radio"
                          Click="OnColorSchemeClick" />
                <MenuItem Header="{x:Static localization:Strings.Mint}"
                          GroupName="SnakeSkin"
                          Tag="{x:Static models:SnakeSkin.Mint}"
                          ToggleType="Radio"
                          Click="OnColorSchemeClick" />
                <MenuItem Header="{x:Static localization:Strings.DarkGreen}"
                          GroupName="SnakeSkin"
                          Tag="{x:Static models:SnakeSkin.DarkGreen}"
                          ToggleType="Radio"
                          Click="OnColorSchemeClick" />
                <MenuItem Header="{x:Static localization:Strings.Blue}"
                          GroupName="SnakeSkin"
                          Tag="{x:Static models:SnakeSkin.Blue}"
                          ToggleType="Radio"
                          Click="OnColorSchemeClick" />
                <MenuItem Header="{x:Static localization:Strings.Pink}"
                          GroupName="SnakeSkin"
                          Tag="{x:Static models:SnakeSkin.Pink}"
                          ToggleType="Radio"
                          Click="OnColorSchemeClick" />
                <MenuItem Header="{x:Static localization:Strings.Yellow}"
                          GroupName="SnakeSkin"
                          Tag="{x:Static models:SnakeSkin.Yellow}"
                          ToggleType="Radio"
                          Click="OnColorSchemeClick" />
                <MenuItem Header="{x:Static localization:Strings.Scarlet}"
                          GroupName="ParrotPlumage"
                          Tag="{x:Static models:ParrotPlumage.Scarlet}"
                          ToggleType="Radio"
                          Click="OnColorSchemeClick" />
                <MenuItem Header="{x:Static localization:Strings.BlueAndGold}"
                          GroupName="ParrotPlumage"
                          Tag="{x:Static models:ParrotPlumage.BlueAndGold}"
                          ToggleType="Radio"
                          Click="OnColorSchemeClick" />
                <MenuItem Header="{x:Static localization:Strings.Green}"
                          GroupName="ParrotPlumage"
                          Tag="{x:Static models:ParrotPlumage.Green}"
                          ToggleType="Radio"
                          Click="OnColorSchemeClick" />
                <MenuItem Header="{x:Static localization:Strings.Hyacinth}"
                          GroupName="ParrotPlumage"
                          Tag="{x:Static models:ParrotPlumage.Hyacinth}"
                          ToggleType="Radio"
                          Click="OnColorSchemeClick" />
            </MenuItem>
            <MenuItem Header="{x:Static localization:Strings.Size}">
                <MenuItem Header="{x:Static localization:Strings.Small}"
                          GroupName="Size"
                          Tag="{x:Static models:AnimalSize.Small}"
                          ToggleType="Radio"
                          Click="OnSizeClick" />
                <MenuItem Header="{x:Static localization:Strings.Medium}"
                          GroupName="Size"
                          Tag="{x:Static models:AnimalSize.Medium}"
                          ToggleType="Radio"
                          Click="OnSizeClick" />
                <MenuItem Header="{x:Static localization:Strings.Large}"
                          GroupName="Size"
                          Tag="{x:Static models:AnimalSize.Large}"
                          ToggleType="Radio"
                          Click="OnSizeClick" />
            </MenuItem>
            <MenuItem Header="{x:Static localization:Strings.Configuration}">
                <MenuItem x:Name="TopmostMenuItem"
                          Header="{x:Static localization:Strings.AlwaysOnTop}"
                          ToggleType="CheckBox"
                          Click="OnTopmostClick" />
                <MenuItem x:Name="LaunchAtStartupMenuItem"
                          Header="{x:Static localization:Strings.LaunchAtStartup}"
                          ToggleType="CheckBox"
                          Click="OnLaunchAtStartupClick" />
            </MenuItem>
            <Separator />
            <MenuItem Header="{x:Static localization:Strings.Recenter}"
                      Click="OnRecenterClick" />
            <MenuItem Header="{x:Static localization:Strings.CheckForUpdates}"
                      Click="OnCheckUpdatesClick" />
            <MenuItem Header="{x:Static localization:Strings.Help}">
                <MenuItem Header="{x:Static localization:Strings.Website}"
                          Click="OnWebsiteClick" />
                <MenuItem Header="{x:Static localization:Strings.About}"
                          Click="OnAboutClick" />
            </MenuItem>
            <Separator />
            <MenuItem Header="{x:Static localization:Strings.Quit}"
                      Click="OnQuitClick" />
        </ContextMenu>
    </Window.ContextMenu>

</Window>
